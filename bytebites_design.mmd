%% ByteBites System Design
%% Four classes, related by composition (has-a containers), never inheritance (is-a).
%% Design notes are in README.md.
classDiagram
  class Customer {
    +str name
    +list~Order~ purchase_history
    +add_order(order: Order) None
  }
  %% is_verified() bool is intentionally left out

  class FoodItem {
    +str name
    +float price
    +str category
    +float popularity_rating
  }

  class Menu {
    +list~FoodItem~ items
    +add_item(item: FoodItem) None
    +filter_by_category(category: str) list~FoodItem~
    +sort_by_popularity() list~FoodItem~
  }

  class Order {
    +list~FoodItem~ items
    +add_item(item: FoodItem) None
    +calculate_total() float
  }

  Customer "1" *-- "*" Order : purchase_history
  Order "1" *-- "*" FoodItem : contains
  Menu "1" *-- "*" FoodItem : contains
